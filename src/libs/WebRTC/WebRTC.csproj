<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>tryAGI.WebRTC</AssemblyName>
    <RootNamespace>tryAGI.WebRTC</RootNamespace>
    <PackageId>tryAGI.WebRTC</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>tryAGI and contributors</Authors>
    <Description>Independent .NET 10 initial Opus/data peer with bounded SDP, UDP ICE, fingerprint-bound DTLS/SRTP and reliable/partial SCTP/DCEP channels. Same-socket STUN and an owned UDP TURN allocation path are available; local relay ICE integration, video and general negotiation remain in development.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>../../public.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
