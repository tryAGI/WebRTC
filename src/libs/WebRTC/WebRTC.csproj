<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>tryAGI.WebRTC</AssemblyName>
    <RootNamespace>tryAGI.WebRTC</RootNamespace>
    <PackageId>tryAGI.WebRTC</PackageId>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
    <RepositoryUrl>https://github.com/tryAGI/WebRTC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Authors>tryAGI and contributors</Authors>
    <Description>MIT WebRTC transport for .NET 10: bounded ICE/STUN/TURN, fingerprint-authenticated DTLS/SRTP, Opus/H264/VP8 packet transport and SCTP data channels. Experimental 0.x; framework-only runtime.</Description>
    <PackageProjectUrl>https://github.com/tryAGI/WebRTC</PackageProjectUrl>
    <PackageTags>webrtc;dotnet;ice;stun;turn;dtls;srtp;sctp;opus;h264;vp8;nativeaot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>../../public.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <Target Name="GenerateWebRtcBuildIdentity" BeforeTargets="CoreCompile" DependsOnTargets="MinVer;InitializeSourceControlInformation">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageVersion)', '^0\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?(\+[0-9A-Za-z.-]+)?$'))" Text="Build identity requires an experimental semantic package version." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevisionId)', '^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})?$'))" Text="Build identity source revision must be a full Git object ID or empty." />
    <PropertyGroup>
      <_WebRtcBuildIdentityFile>$(IntermediateOutputPath)WebRtcBuildInfo.g.cs</_WebRtcBuildIdentityFile>
    </PropertyGroup>
    <ItemGroup>
      <_WebRtcBuildIdentityLine Include="// Generated from the same package/source properties used by the SDK. Do not edit." />
      <_WebRtcBuildIdentityLine Include="namespace tryAGI.WebRTC%3B" />
      <_WebRtcBuildIdentityLine Include="public static partial class WebRtcBuildInfo" />
      <_WebRtcBuildIdentityLine Include="{" />
      <_WebRtcBuildIdentityLine Include="    private static partial WebRtcBuildIdentity Create() =&gt; new(&quot;tryAGI.WebRTC&quot;, &quot;$(PackageVersion)&quot;, &quot;$(SourceRevisionId)&quot;)%3B" />
      <_WebRtcBuildIdentityLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_WebRtcBuildIdentityFile)" Lines="@(_WebRtcBuildIdentityLine)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(_WebRtcBuildIdentityFile)" />
      <FileWrites Include="$(_WebRtcBuildIdentityFile)" />
    </ItemGroup>
  </Target>
  <Target Name="RequireExperimentalPackageVersion" BeforeTargets="GenerateNuspec" DependsOnTargets="MinVer">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageVersion)', '^0\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?$'))" Text="WebRTC publication is restricted to 0.x versions." />
  </Target>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <None Include="../../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
